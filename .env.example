RUST_LOG=info,hhm_api=debug
HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hhm
SUPABASE_URL=https://example.supabase.co
SUPABASE_PROJECT_REF=example
SUPABASE_ANON_KEY=replace-me
SHARED_AUTH_BASE_URL=https://auth.example.test
SHARED_AUTH_ISSUER=https://auth.example.test
SHARED_AUTH_AUDIENCE=hhm-api
AUTH_INTROSPECT_SECRET=replace-me
# Exact, comma-separated provider|tenant|subject identities allowed to issue QR codes.
# Never use an email address or a Shared Auth role as product authorization.
HHM_QR_ISSUER_IDENTITIES=supabase|example|replace-with-provider-subject
VISITOR_QR_SIGNING_KEY=replace-with-unpadded-base64url-encoded-32-to-64-byte-secret
VISITOR_DOOR_IDS=front-door
VISITOR_PRIVACY_NOTICE_VERSION=privacy-2026-08
PUBLIC_BASE_URL=http://localhost:8080
# Local scaffold only. Production reservations require product authorization and persistence.
ALLOW_UNAUTHENTICATED_DEMO_RESERVATIONS=false
# Comma-separated exact http(s) origins. Empty means no cross-origin access.
# Wildcards and origins containing paths or query strings are rejected.
CORS_ORIGINS=http://localhost:3000
